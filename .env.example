# Example Environment Configuration
# Copy this file to .env.development or .env.production and fill in your values
# NEVER commit real credentials to git!

NODE_ENV=development

# Server
PORT=3050
API_URL=http://localhost:3050
FRONTEND_URL=http://localhost:3050
PUBLIC_SITE_URL=http://localhost:3050

# Database
# For production with auth: mongodb://username:password@host:port/dbname?authSource=admin
MONGODB_URL=mongodb://localhost:27017/soccer

# Logging (debug, info, warn, error)
LOG_LEVEL=debug

# Swagger Documentation (true/false - always enabled in development)
ENABLE_SWAGGER=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=500
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=120

# CORS (use * for development, specific origins for production)
CORS_ORIGINS=*

# Hardened Internal, Webhook & Android Signing Secrets
NORRA_INTERNAL_API_KEY=replace_with_strong_random_master_key
CRON_SECRET=replace_with_strong_random_cron_secret
FLUTTERWAVE_WEBHOOK_HASH=replace_with_flutterwave_webhook_secret_hash
# Optional: comma-separated webhook URLs for other apps sharing the same Flutterwave account
FLUTTERWAVE_WEBHOOK_FORWARD_URL=
ANDROID_KEYSTORE_PASS=replace_with_keystore_password
ANDROID_KEY_PASS=replace_with_key_password
